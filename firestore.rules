rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 輔助函式 ──
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'taidu.patisserie.2025@gmail.com') ||
        (exists(/databases/$(database)/documents/employees/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.isAdmin == true ||
          get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.role == 'admin'
        ))
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── 1. 員工資料 ──
    match /employees/{employeeId} {
      allow read: if isOwner(employeeId) || isAdmin();
      allow write: if isAdmin();
    }

    // ── 2. 出勤打卡紀錄 ──
    match /attendance/{attendanceId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.employeeId == request.auth.uid);
      // 建立時要求：
      //   1. timestamp 欄位必須使用伺服器時間（防止偽造打卡時間）
      //   2. 只允許特定欄位（防止注入額外欄位）
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.employeeId == request.auth.uid &&
        request.resource.data.timestamp == request.time &&
        request.resource.data.keys().hasOnly([
          'empName', 'employeeId', 'date', 'time', 'type',
          'coords', 'timestamp', 'status', 'scheduleId'
        ])
      );
      allow update, delete: if isAdmin();
    }

    // ── 3. 排班表 ──
    match /schedules/{scheduleId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.employeeId == request.auth.uid);
      allow write: if isAdmin();
    }

    // ── 4. 薪資單 ──
    match /payroll/{payrollId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.employeeId == request.auth.uid);
      allow write: if isAdmin();
      // 排定自動發佈：時間到了任何已登入的使用者（含員工打卡頁面）都可以將 isPublished 翻成 true
      // 條件：1) 只改 isPublished 欄位  2) 改成 true  3) scheduledPublishAt 已到期
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPublished'])
        && request.resource.data.isPublished == true
        && resource.data.scheduledPublishAt != null
        && resource.data.scheduledPublishAt <= request.time.toMillis();
    }

    // ── 5. 系統設定 ──
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── 6. 請假申請 ──
    match /leaves/{leaveId} {
      // 管理員可讀全部；員工只能讀自己的
      allow read: if isAdmin() || (isSignedIn() && resource.data.employeeId == request.auth.uid);
      // 建立時強制 status == 'pending'（防止員工建立已審核的假單）
      allow create: if isAdmin() ||
        (isSignedIn() &&
         request.resource.data.employeeId == request.auth.uid &&
         request.resource.data.status == 'pending');
      // 員工可：
      //   a) 撤銷（status: pending → cancelled）
      //   b) 修改待審假單的日期/時數/原因/假別（status 保持 pending）
      allow update: if isAdmin() ||
        (isSignedIn() &&
         resource.data.employeeId == request.auth.uid &&
         resource.data.status == 'pending' &&
         (
           // 撤銷
           (request.resource.data.status == 'cancelled' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])) ||
           // 修改內容，status 維持 pending
           (request.resource.data.status == 'pending' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'date', 'hours', 'reason', 'type', 'startDate', 'endDate'
            ]))
         )
        );
      allow delete: if isAdmin();
    }

    // ── 7. 加班申請 ──
    match /overtime_requests/{otId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.employeeId == request.auth.uid);
      // 建立時強制 status == 'pending'
      allow create: if isAdmin() ||
        (isSignedIn() &&
         request.resource.data.employeeId == request.auth.uid &&
         request.resource.data.status == 'pending');
      allow update: if isAdmin() ||
        (isSignedIn() &&
         resource.data.employeeId == request.auth.uid &&
         resource.data.status == 'pending' &&
         request.resource.data.status == 'cancelled');
      allow delete: if isAdmin();
    }

    // ── 8. 補卡申請 ──
    match /punch_corrections/{pcId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.employeeId == request.auth.uid);
      // 建立時強制 status == 'pending'
      allow create: if isAdmin() ||
        (isSignedIn() &&
         request.resource.data.employeeId == request.auth.uid &&
         request.resource.data.status == 'pending');
      allow update, delete: if isAdmin();
    }

    // ── 9. 打卡異常申訴 ──
    match /attendance_appeals/{apId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.employeeId == request.auth.uid);
      // 建立時強制 status == 'pending'
      allow create: if isAdmin() ||
        (isSignedIn() &&
         request.resource.data.employeeId == request.auth.uid &&
         request.resource.data.status == 'pending');
      allow update, delete: if isAdmin();
    }
  }
}
